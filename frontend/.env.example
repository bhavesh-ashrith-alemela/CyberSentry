# ==============================================================================
# CyberSentry Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL
#
# 1. Local Development:
#    Points to your local Express server running on port 5001:
#    NEXT_PUBLIC_API_BASE_URL=http://localhost:5001
#
# 2. Production (Vercel Deployment):
#    Points to your live Render backend Web Service URL:
#    NEXT_PUBLIC_API_BASE_URL=https://cybersentry-backend.onrender.com
#
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001
