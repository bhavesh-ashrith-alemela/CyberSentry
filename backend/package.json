{
  "name": "cybersentry-backend",
  "version": "1.0.0",
  "description": "CyberSentry Backend API and Privacy Scanner",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "tsx -e \"import('./src/db/index.js').then(m => m.testConnection())\"",
    "test": "tsx src/test-api.ts",
    "test:scanner": "tsx src/test-scanner.ts",
    "test:analyzer": "tsx src/analyzer/analyzer.test.ts"
  },
  "keywords": [
    "privacy",
    "scanner",
    "cookies",
    "postgresql",
    "drizzle-orm",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "playwright": "^1.47.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
