# ==============================================================================
# CyberSentry Backend Environment Configuration
# ==============================================================================

# Runtime Environment
NODE_ENV=production

# Server Port & Binding (Render automatically assigns PORT)
PORT=10000
HOST=0.0.0.0

# PostgreSQL Connection URL
# On Render, use the Internal Database URL provided by your Render PostgreSQL service:
# Example: postgresql://cybersentry:password@dpg-xxxx-a/cybersentry
DATABASE_URL=postgresql://postgres:password@localhost:5432/cybersentry

# CORS Allowed Origin for Vercel Deployed Frontend
# Set to your production Vercel URL (e.g. https://cybersentry.vercel.app)
# Note: server.js automatically allows any https://*.vercel.app subdomain
FRONTEND_ORIGIN=https://cybersentry.vercel.app

# Playwright Headless Crawling Configuration
PLAYWRIGHT_HEADLESS=true

# Website Crawl Navigation Timeout (in milliseconds)
SCAN_TIMEOUT_MS=30000
