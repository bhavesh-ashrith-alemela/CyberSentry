# ============================================================
# CyberSentry PostgreSQL Environment Configuration
# ============================================================

NODE_ENV=development
PORT=5001

# ------------------------------------------------------------
# Database Connection (PostgreSQL)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
# ------------------------------------------------------------

# Option 1: Local PostgreSQL (standard local development)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/cybersentry

# Option 2: Cloud PostgreSQL (production / Neon / Render / Supabase)
# DATABASE_URL=postgresql://neondb_owner:password@ep-host.region.aws.neon.tech/cybersentry?sslmode=require
